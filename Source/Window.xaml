<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustEnoughTools"
        Width="{StaticResource Size.WindowWidth}" Height="{StaticResource Size.WindowHeight}"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowBackdrop}"
        Foreground="{DynamicResource Brush.Text}" FontFamily="{StaticResource Font.Family}"
        FontSize="{StaticResource Font.Body}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Margin="{StaticResource Pad.Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Style="{StaticResource SettingsScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      KeyboardNavigation.DirectionalNavigation="Continue" AutomationProperties.Name="Инструменты">
            <StackPanel>
                <Expander x:Name="WalkieTalkieSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="WalkieTalkie">
                    <Expander.Header>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CategoryIcon}" Text="&#xE720;" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Grid.Column="1" Text="WalkieTalkie" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <Grid/>
                </Expander>
                <Expander x:Name="ClickerSection" Margin="{StaticResource Gap.Row}" AutomationProperties.Name="Clicker">
                    <Expander.Header>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CategoryIcon}" Text="&#xE962;" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Grid.Column="1" Text="Clicker" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <Grid/>
                </Expander>
                <Border x:Name="ProtectionCard" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}"
                        CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path x:Name="ProtectionIcon" Width="20" Height="20" Margin="0,0,16,0" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12 3 L20 6 L19.5 12 C19 16 16 19 12 21 C8 19 5 16 4.5 12 L4 6 Z M3 21 L21 3"/>
                            <TextBlock x:Name="ProtectionTitle" Grid.Column="1" Text="Отключить защиту Windows (временно)" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ConfigureSecurityButton" Content="Отключить" MinWidth="{StaticResource Size.ActionButton}"
                                    Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                                    AutomationProperties.Name="Применить доступные настройки защиты Windows"/>
                            <Button x:Name="SaveButton" Content="Сохранить" Margin="0,0,8,0"
                                    ToolTip="Сохранить автономный EXE для выполнения настройки"/>
                            <Button x:Name="IconButton" Width="{Binding ActualHeight, ElementName=SaveButton}"
                                    Height="{Binding ActualHeight, ElementName=SaveButton}" Padding="4"
                                    ToolTip="Выбрать иконку" AutomationProperties.Name="Выбрать иконку">
                                <Image x:Name="CurrentIcon" Width="24" Height="24"/>
                            </Button>
                        </StackPanel>
                        <CheckBox x:Name="AddToStartMenu" Grid.Row="1" Grid.Column="0" Content="Добавить в меню пуск"
                                  IsChecked="True" MinHeight="32" Margin="0,8,16,0"
                                  ToolTip="Создать ярлык сохранённого EXE в меню «Пуск» текущего пользователя"/>
                        <TextBlock x:Name="ProtectionDescription" Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="Требуются права администратора"/>
                        <Popup x:Name="IconPopup" PlacementTarget="{Binding ElementName=IconButton}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                            <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}"
                                    Padding="{StaticResource Pad.Popup}">
                                <UniformGrid x:Name="IconChoices" Rows="1" Columns="3" Width="216" KeyboardNavigation.TabNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <Border x:Name="TaskbarCard" Margin="0,8,0,0" Background="{DynamicResource Brush.Surface}"
                        ToolTip="Режим 1: Главная панель задач и панель задач, в которой открыто окно&#x0A;Режим 2: Панель задач, в которой открыто окно"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{StaticResource Border.Control}"
                        CornerRadius="{StaticResource Radius.Panel}" Padding="{StaticResource Pad.Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path x:Name="TaskbarSettingIcon" Width="20" Height="20" Margin="0,0,16,0" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3 5 L21 5 L21 18 L3 18 Z M3 14 L21 14 M12 18 L12 21 M8 21 L16 21 M9 16 L10 16 M12 16 L13 16 M15 16 L16 16"/>
                            <TextBlock x:Name="TaskbarTitle" Grid.Column="1" Text="Исправление панели задач" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="TaskbarModeSwitch" Style="{StaticResource TaskbarModeSwitchStyle}" IsChecked="False" Margin="0,0,12,0"
                                      ToolTip="Режим 1: Главная панель задач и панель задач, в которой открыто окно&#x0A;Режим 2: Панель задач, в которой открыто окно" AutomationProperties.Name="Режим исправления панели задач"/>
                            <Button x:Name="ApplyTaskbarButton" Content="Применить" MinWidth="{StaticResource Size.ActionButton}"
                                    Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                                    AutomationProperties.Name="Исправить панель задач"/>
                            <Button x:Name="TaskbarSaveButton" Content="Сохранить" Margin="0,0,8,0"
                                    ToolTip="Сохранить автономный EXE для выполнения настройки"/>
                            <Button x:Name="TaskbarIconButton" Width="{Binding ActualHeight, ElementName=TaskbarSaveButton}"
                                    Height="{Binding ActualHeight, ElementName=TaskbarSaveButton}" Padding="4"
                                    ToolTip="Выбрать иконку" AutomationProperties.Name="Выбрать иконку">
                                <Image x:Name="TaskbarCurrentIcon" Width="24" Height="24"/>
                            </Button>
                        </StackPanel>
                        <CheckBox x:Name="TaskbarAddToStartMenu" Grid.Row="1" Grid.Column="0" Content="Добавить в меню пуск"
                                  IsChecked="True" MinHeight="32" Margin="0,8,16,0"
                                  ToolTip="Создать ярлык сохранённого EXE в меню «Пуск» текущего пользователя"/>
                        <Popup x:Name="TaskbarIconPopup" PlacementTarget="{Binding ElementName=TaskbarIconButton}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                            <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="{StaticResource Border.Control}" CornerRadius="{StaticResource Radius.Panel}"
                                    Padding="{StaticResource Pad.Popup}">
                                <UniformGrid x:Name="TaskbarIconChoices" Rows="1" Columns="3" Width="216" KeyboardNavigation.TabNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="UpdateArea" Grid.Row="1" Margin="{StaticResource Gap.Footer}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.ProgressTrack}"/>
                <TextBlock x:Name="UpdateProgressText" Text="Проверка обновлений" Style="{StaticResource ProgressTextStyle}"/>
            </Grid>
            <Button x:Name="UpdateButton" Grid.Column="1" Content="Обновить" Width="{StaticResource Size.ActionButton}"
                    Margin="{StaticResource Gap.ActionButton}" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
